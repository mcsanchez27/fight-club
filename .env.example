DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
ANTHROPIC_API_KEY=
# V1 override/fallback for the ruling model. Prefer FIGHT_MODEL_RULING below.
ANTHROPIC_MODEL=
# Ruling model (default claude-sonnet-5). If unset, falls back to ANTHROPIC_MODEL, then the default.
FIGHT_MODEL_RULING=claude-sonnet-5
# Balance-check model (wired for V2 item 3; default Haiku 4.5 dated id).
FIGHT_MODEL_BALANCE=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
FIGHT_COOLDOWN_SECONDS=60
FIGHT_GUILD_DAILY_CAP=50
FIGHT_MONTHLY_USD_CAP=20
FIGHT_TOKEN_CEILING=16000
FIGHT_RETRIEVAL_ENABLED=1
# Global wall-clock budget for parallel wiki/HTML retrieval (seconds).
FIGHT_RETRIEVAL_BUDGET_SECONDS=10
# Sonnet 5 defaults: $2 / $10 per million tokens (override if Anthropic pricing changes).
FIGHT_USD_PER_MTOK_INPUT=2.0
FIGHT_USD_PER_MTOK_OUTPUT=10.0
# Challenge card expiry (hours); guild_config can override.
FIGHT_CHALLENGE_TIMEOUT_HOURS=6
# Max counters per advocate side before void (guild_config can override).
FIGHT_COUNTERS_PER_SIDE=2
# Warn on the challenge card when balance score is strictly below this (1–10, 10=even).
FIGHT_BALANCE_WARN_BELOW=4
# Free Counter (does not consume quota) when the card is balance-warned.
FIGHT_BALANCE_FREE_COUNTER=1
# Rest deadline after first /rest (hours); guild_config can override.
FIGHT_REST_TIMEOUT_HOURS=24
